# Copy to .env, fill it in, then `docker compose up -d`.
#
# Everything here is read once when a container starts, so changing a value
# means `docker compose up -d` again. None of it is a business rule: radii,
# fees, COD limits and commission are tuned at runtime by an admin and live in
# the config module (ADR 0004).

# ---------------------------------------------------------------- the basics

# The domain this is served on. Its A record must already point at this
# machine, or Caddy cannot get a certificate.
GOKLAY_DOMAIN=demo.example.com

# Where Let's Encrypt sends expiry warnings.
TLS_EMAIL=you@example.com

# The same name, as the apps and the API see it. Must be https.
PUBLIC_BASE_URL=https://demo.example.com

# development | staging | production
#
# production is not yet reachable: it requires a real SMS gateway and a real
# payment gateway, and the binary refuses to start without them. Use staging.
APP_ENV=staging

# ------------------------------------------------------------------ the demo

# true turns this into a public demonstration: one-time codes come back in the
# response instead of being sent, and a manual-gateway payment can be settled
# from the app. It cannot be set with APP_ENV=production.
#
# A demo is a deployment where anyone can sign in as anyone. See docs/demo.md.
DEMO_MODE=true

# The seeded admin, used by the dispatch heartbeat to sign itself in.
# 01700000031 is the demo admin from seed/0009_demo_accounts.sql.
ADMIN_PHONE=01700000031

# ----------------------------------------------------------------- the stores

POSTGRES_USER=goklay
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=goklay

# ---------------------------------------------------------------- the secrets
#
# Generate both, even for a demo. Outside production the signing key otherwise
# defaults to a value printed in this repository's source, which would let
# anybody mint an admin token for your deployment.
#
#   openssl rand -base64 48

JWT_SIGNING_KEY=
PAYMENT_WEBHOOK_SECRET=

# The `iss` claim, so a token from one environment is refused by another.
JWT_ISSUER=goklay

# ------------------------------------------------------------------ the rest

# Web origins allowed to call the API. Empty is right for a mobile-only
# deployment; the apps are native and need no CORS.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=info

# How often the tracking stream polls for a change to send. Lower feels
# faster and costs a query per open stream per tick.
TRACKING_STREAM_INTERVAL=3s

# Seconds between dispatch sweeps. dispatch.assignment_timeout is 30s by
# default, so anything above ~15 adds its own interval to every reassignment.
SWEEP_INTERVAL=12
